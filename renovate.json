{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 1,
  "postUpdateOptions": ["composerWithAll", "pnpmDedupe"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": true,
    "platformAutomerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/setup-ci/action\\.yml$/"],
      "matchStrings": ["tools:\\s*[^\\n]*(?<depName>composer):(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Dockerfileとカスタムアクション内のcomposerをグループ化して自動マージ",
      "matchPackageNames": ["composer"],
      "matchManagers": ["dockerfile", "custom.regex"],
      "groupName": "composer-deps",
      "groupSlug": "composer-update",
      "schedule": ["every day at 5:10am"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "毎日 5:10：その他のすべてのアップデート（メジャー含む）を自動マージ対象",
      "schedule": ["every day at 5:10am"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
