{
    "name": "ninton/smartybook",
    "description": "Smarty動的Webサイト構築入門のCDROM",
    "type": "project",
    "license": "MIT",
    "config": {
        "policy": {
            "advisories": {
                "ignore": [
                    "smarty/smarty"
                ]
            }
        },
        "sort-packages": true
    },
    "scripts": {
       "db:reset": "bash ./scripts/local/db_init.sh",
       "lint": "phpstan analyse --configuration=phpstan.dist.neon --memory-limit=-1",
       "lint:baseline": "phpstan analyse --configuration=phpstan.dist.neon --memory-limit=-1 --generate-baseline=phpstan-baseline.neon  --allow-empty-baseline",
       "lint:fix": "phpstan analyse --configuration=phpstan.dist.neon --memory-limit=-1 --fix",
       "lint:fresh": "phpstan clear-result-cache && phpstan analyse --configuration phpstan.dist.neon --memory-limit 1G",
       "test": "vendor/bin/phpunit --colors=always",
       "test:golden-master": ["@db:reset", "./vendor/bin/phpunit --colors=always tests/GoldenMaster"],
       "test:golden-master-update": [
          "@db:reset",
            "SHOULD_UPDATE_GOLDEN_MASTER=1 ./vendor/bin/phpunit --colors=always tests/GoldenMaster"
        ],
        "composer-require-checker": "composer-require-checker check composer.json"
    },
    "require": {
        "php": "^8.0",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "smarty/smarty": "^4.3",
        "symfony/polyfill-php80": "^1.37"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.36",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "maglnet/composer-require-checker": "^3.8"
    },
    "include-path": [
        "lib/pear-pear.php.net/Archive_Tar",
        "lib/pear-pear.php.net/Auth",
        "lib/pear-pear.php.net/Console_Getopt",
        "lib/pear-pear.php.net/HTTP_Request",
        "lib/pear-pear.php.net/Net_Socket",
        "lib/pear-pear.php.net/Net_URL",
        "lib/pear-pear.php.net/Net_UserAgent_Mobile",
        "lib/pear-pear.php.net/Pager",
        "lib/pear-pear.php.net/PEAR",
        "lib/pear-pear.php.net/Services_Amazon",
        "lib/pear-pear.php.net/Structures_Graph",
        "lib/pear-pear.php.net/XML_Parser",
        "lib/pear-pear.php.net/XML_Serializer",
        "lib/pear-pear.php.net/XML_Util"
    ],
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "psr-4": {
            "SmartyBook\\": "smartybook/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }

}
